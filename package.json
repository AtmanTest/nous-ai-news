{
  "name": "nous-ai-news",
  "version": "2.0.0",
  "private": true,
  "description": "Nous AI News — agrégateur d'actualités IA, refondu avec un workflow QA complet (ISTQB Foundation + GenAI).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:unit:cov": "vitest run --coverage",
    "test:api": "playwright test --project=api",
    "test:e2e": "playwright test --project=e2e-desktop --project=e2e-mobile",
    "test:smoke": "playwright test --grep @smoke",
    "test:module": "node scripts/qa/test-module.mjs",
    "test:all": "npm run typecheck && npm run test:unit && npm run test:api && npm run test:e2e",
    "qa:trace": "node scripts/qa/check-traceability.mjs",
    "qa:prompt": "node scripts/qa/build-test-prompt.mjs",
    "qa:report": "playwright show-report",
    "build:pages": "node scripts/pages/build-static.mjs"
  },
  "dependencies": {
    "next": "14.2.35",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.60.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitest/coverage-v8": "^4.1.8",
    "autoprefixer": "^10.4.20",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
}
